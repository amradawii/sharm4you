APP_NAME=Sharm4You
APP_ENV=local                  # production: production
APP_KEY=
APP_DEBUG=true                 # production: false
APP_URL=http://localhost       # production: https://sharm4you.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single               # production: daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug                # production: warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sharm4you
DB_USERNAME=root
DB_PASSWORD=

# Sessions are stored in the database. Lifetime is idle minutes (10080 = 7 days).
SESSION_DRIVER=database
SESSION_LIFETIME=10080
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false    # production: true (HTTPS only)

# Must be persistent (database): rate-limit counters live in the cache.
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log

# Cloudflare R2: private bucket for tourist photo delivery.
# R2_ENDPOINT looks like https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_DEFAULT_REGION=auto
R2_BUCKET=
R2_ENDPOINT=
